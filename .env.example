# ============================================
# landscape-photo-agent 環境変数
# ============================================
# このファイルをコピーして .env を作成してください。
# .env は .gitignore 対象です。
#
#   cp .env.example .env
#
# Cloud Run へのデプロイ時は Secret Manager または
# gcloud run deploy --set-env-vars で設定します。

# --- LINE Messaging API ---
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LINE 署名検証の有効化（通常は false のまま）
# 現構成は LINE → GAS → Cloud Run のため、GAS 転送時にボディが変化し
# 署名検証は構造的に一致しない。LINE 直結に戻す場合のみ true にする。
VERIFY_LINE_SIGNATURE=false

# --- Google AI (Gemini) ---
GOOGLE_API_KEY=

# --- Google Maps API ---
# Places API (New) + Elevation API で未知地点の座標・標高を解決する。
# 未設定の場合、未知地点の解決は無効化され登録地点のみで運用される。
GOOGLE_MAPS_API_KEY=

# --- Google Drive ファイル ID ---
# 各 JSON ファイルの Drive ファイル ID。Drive 上にファイルを作成し、
# サービスアカウントに編集権限を共有してから ID を設定する。
# 未設定の場合、該当機能（保存・参照）はスキップされる。
PREDICTIONS_FILE_ID=
ACTUALS_FILE_ID=
SPOT_GROUPS_FILE_ID=
FOG_KNOWLEDGE_FILE_ID=
